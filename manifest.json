{
  "manifest_version": 3,
  "name": "PhilGeps BidOps Matcher",
  "version": "3.1.0",
  "description": "Official PhilGEPS procurement opportunity extraction, highlighting, and monitoring for verified PhilGEPS listings.",
  "minimum_chrome_version": "114",
  "permissions": ["storage", "scripting", "tabs", "notifications", "sidePanel", "alarms"],
  "host_permissions": [
    "https://philgeps.gov.ph/*",
    "https://*.philgeps.gov.ph/*"
  ],
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "action": {
    "default_title": "PhilGeps BidOps Matcher — toggle side panel",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://philgeps.gov.ph/*",
        "https://*.philgeps.gov.ph/*"
      ],
      "js": [
        "constants.js",
        "url-utils.js",
        "governmentEntities.js",
        "entity-detector.js",
        "date-validator.js",
        "location-detector.js",
        "procurement-classifier.js",
        "procurement-adapters.js",
        "keyword-highlighter.js",
        "matcher.js",
        "qualifier.js",
        "scanner.js",
        "universal-extractor.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
